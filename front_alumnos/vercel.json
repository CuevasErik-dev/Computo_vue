{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self' data:; connect-src 'self' https://nicolette-tissual-lashunda.ngrok-free.dev; img-src 'self' data:;"
                }
            ]
        }
    ]
}